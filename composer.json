{
  "name": "tsnc/prisma-php",
  "description": "Prisma PHP: The Next-Gen Framework Merging PHP’s Power with Prisma's ORM Mastery",
  "version": "4.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "PP\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PP\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "bench": "php benchmarks/runtime.php"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Jefferson",
      "email": "thesteelninjacode@gmail.com"
    }
  ]
}
